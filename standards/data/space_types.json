{
  "_meta": {
    "version": "0.1.0",
    "updated": "2026-09-22",
    "purpose": "Room-level standards, derived from the ergonomic layer rather than asserted alongside it. A space type declares the ACTIVITIES it must support; the rule engine turns those into dimensions using the envelopes in ergonomics.json for whichever user group is being tested. Change the user group and every requirement moves, which is the whole point.",
    "derivation_note": "Where a dimension is given directly (min_width, min_area) it is a regulatory minimum and is cited. Where it is derived from activities it carries no number here at all — the engine computes it. Mixing the two silently is how standards documents become impossible to update.",
    "provenance": "Regulatory minima cited. `neufert_ref` left empty for your own verification pass."
  },

  "space_types": [
    {
      "id": "bedroom_single",
      "label": "Single bedroom",
      "category": "habitable",
      "min_area_m2": 7.0,
      "min_width_mm": 2100,
      "requires_daylight": true,
      "requires_openable_window": true,
      "min_ceiling_mm": 2400,
      "activities": ["make_bed", "open_wardrobe", "stand_and_turn", "pass_single"],
      "required_fixtures": ["bed", "wardrobe"],
      "acoustic_class": "B",
      "ventilation_ls_per_person": 7,
      "source_ref": ["BBR 3:22", "SS 91 42 21"],
      "neufert_ref": "",
      "notes": "7 m² is a regulatory floor, not a target. A single bedroom that meets it and fails the activity checks below is compliant and unusable — which is exactly the gap this engine exists to expose."
    },
    {
