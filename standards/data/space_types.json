    {
      "id": "kitchen",
      "label": "Kitchen",
      "category": "service",
      "min_area_m2": 5.0,
      "min_width_mm": 1800,
      "requires_daylight": false,
      "activities": ["work_at_counter", "bend_to_oven", "open_drawer", "stand_and_turn"],
